# Optional premium voice (text-to-speech). Get a key at elevenlabs.io → Profile → API keys.
# ELEVENLABS_API_KEY=
# Or Cartesia (the fastest to start speaking). play.cartesia.ai → API keys. Echo counts what it sends
# against the free plan (20,000 a month, from the 1st); set these if your plan or billing day differ.
# CARTESIA_API_KEY=
# CARTESIA_MONTHLY_CHARS=20000
# CARTESIA_RESET_DAY=1

# Optional cloud speech recognition (Deepgram Nova-3, paid per minute). console.deepgram.com → API keys.
# DEEPGRAM_API_KEY=
